@article{donascimentoMultiobjectiveOptimizationParadigm2021,
  title = {Multiobjective {{Optimization Paradigm}} for {{Toroidal Inductors With Spatially Tuned Permeability}}},
  author = {Do Nascimento, Vinicius Cabral and Moon, Seung-Ryul and Byerly, Kevin and Sudhoff, Scott D. and Ohodnicki, Paul R.},
  date = {2021-03},
  journaltitle = {IEEE Transactions on Power Electronics},
