formulas:
  last_update: file.mtime.format("DD/MM/YYYY HH:mm")
properties:
  formula.last_update:
    displayName: Last update
views:
  - type: table
    name: View
    filters:
      and:
        - file.inFolder("notes/hardware/materials")
        - '!file.inFolder("notes/hardware/materials/datasheets")'
        - '!file.inFolder("notes/hardware/materials/info/raw")'
    order:
      - Manufacturer
      - Grade
      - Functionality
      - Filler
      - Filler loading
      - Matrix
      - MOQ
      - Permeability
      - Surface resistivity (Ω/sq)
      - Surface resistance (Ω)
      - Volume resistivity (Ω·m)
      - Thermal conductivity integral (W/m·K)
      - Thermal conductivity in-plane (W/m·K)
      - Thermal conductivity through-plane (W/m·K)
      - Price
      - Lead time
      - Supplier
      - Status
      - Datasheet
      - Processing instructions
      - formula.last_update
    sort:
      - property: Functionality
        direction: DESC
      - property: Surface resistance standard
        direction: ASC
    columnSize:
      note.Functionality: 205
      note.Filler: 89
      note.Filler loading: 103
      note.Surface resistivity (Ω/sq): 25
      note.Supplier: 180
