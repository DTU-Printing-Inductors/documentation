formulas:
  last_update: file.mtime.format("DD/MM/YYYY HH:mm")
properties:
  formula.last_update:
    displayName: Last update
views:
  - type: table
    name: View
    filters:
      and:
        - file.inFolder("notes/hardware/materials")
        - '!file.inFolder("notes/hardware/materials/datasheets")'
        - '!file.inFolder("notes/hardware/materials/info/raw")'
        - Functionality == "Unfilled"
    order:
      - Manufacturer
      - Grade
      - Functionality
      - Filler
      - Filler loading
      - Matrix
      - MOQ
      - Price
      - Lead time
      - Supplier
      - Status
      - Datasheet
      - Processing instructions
      - formula.last_update
    sort:
      - property: Surface resistance standard
        direction: ASC
    columnSize:
      note.Filler: 89
      note.Filler loading: 103
      note.Supplier: 180
      note.status: 100
