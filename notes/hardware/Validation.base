formulas:
  last_update: file.mtime.format("DD/MM/YYYY HH:mm")
properties:
  formula.last_update:
    displayName: Last update
views:
  - type: table
    name: View
    filters:
      and:
        - file.inFolder("notes/hardware/materials/info/validate")
        - '!file.inFolder("notes/hardware/materials/datasheets")'
    order:
      - Manufacturer
      - Grade
      - Functionality
      - Filler
      - Filler loading
      - Matrix
      - MOQ
      - Permeability
      - Magnetic saturation (T)
      - Surface resistivity (Ω/sq)
      - Surface resistance (Ω)
      - Volume resistivity (Ω·m)
      - Thermal conductivity integral (W/m·K)
      - Thermal conductivity in-plane (W/m·K)
      - Thermal conductivity through-plane (W/m·K)
      - Price
      - Lead time
      - Supplier
      - Status
      - Datasheet
      - Processing instructions
      - formula.last_update
      - Dielectric properties
    sort:
      - property: Matrix
        direction: ASC
      - property: Filler loading
        direction: ASC
      - property: Surface resistance standard
        direction: ASC
    columnSize:
      note.Filler: 104
      note.Filler loading: 78
      note.Permeability: 32
      note.Magnetic saturation (T): 87
      note.Supplier: 180
      note.Status: 97
